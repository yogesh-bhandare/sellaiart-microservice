   "source": [
    "import httpx\n",
    "from decouple import config\n",
    "\n",
    "API_ACCESS_KEY=config(\"API_ACCESS_KEY\")\n",
    "\n",
    "headers = {\n",
    "    \"X-API-Key\":API_ACCESS_KEY\n",
    "}\n",
    "\n",
    "endpoint = \"http://127.0.0.1:8000\"\n",
    "res = httpx.get(endpoint, headers=headers)\n",
    "res.status_code, res.json()"
   ]
  }
 ],
